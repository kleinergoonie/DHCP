[Unit]
Description=DHCP Server with Raft Failover (%i)
Documentation=https://github.com/kleinergoonie/DHCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dhcp
Group=dhcp

# Configuration file is /etc/dhcp-server/<instance>.json
# e.g. systemctl start dhcp-server@node1
Environment=CONFIG_FILE=/etc/dhcp-server/%i.json
Environment=PYTHONUNBUFFERED=1

WorkingDirectory=/opt/dhcp-server
ExecStart=/opt/dhcp-server/venv/bin/python raft_server.py \
    --config ${CONFIG_FILE} \
    --log-level INFO

# Allow binding to privileged port 67
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

Restart=on-failure
RestartSec=5s

# Graceful shutdown: send SIGTERM, then SIGKILL after 30s
TimeoutStopSec=30

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/dhcp-server

[Install]
WantedBy=multi-user.target
